{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "eslint.config.js",
    "playwright.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tests/**/*.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  }
}
