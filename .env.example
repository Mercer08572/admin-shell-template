# 接口前缀。开发时由 Vite 代理到 VITE_API_PROXY_TARGET；生产环境由网关/反向代理转发。
VITE_API_BASE_URL=/api/v1

# 是否使用进程内 mock 数据（src/api/mock）。开发默认开启（见 .env.development），
# 因此 pnpm dev 不需要任何后端就能跑通登录、列表、增删改。
# 接自己的后端时把这里和 .env.development 里的值都改成 false，并配置下面的代理地址。
VITE_USE_MOCK=true

# VITE_USE_MOCK=false 时，开发服务器把 VITE_API_BASE_URL 代理到这个地址。
VITE_API_PROXY_TARGET=http://localhost:8181
